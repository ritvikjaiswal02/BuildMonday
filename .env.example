# BuildMonday environment variables.
# Copy to .env.local for development. Every variable is optional for `next build`;
# missing ones turn the related feature off instead of crashing.

# ---- Analysis (Gemini) ----
# Gemini API key for analysis and embeddings (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Generation model id. Default: gemini-2.5-flash
GEMINI_MODEL=
# Embedding model id. Default: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=

# ---- Platform ----
# Postgres connection string (Neon, Supabase or Vercel Postgres). Pooled URLs work.
DATABASE_URL=
# Auth.js cookie and JWT secret. Generate with: npx auth secret
AUTH_SECRET=
# Trust the request host for Auth.js callbacks. Set to true on Vercel.
AUTH_TRUST_HOST=
# Canonical origin for Auth.js (same value as NEXT_PUBLIC_APP_URL). Email sign-in links are always built on
# NEXT_PUBLIC_APP_URL, never on the request's Host header.
AUTH_URL=
# Absolute base URL used in emails, Slack messages, the widget snippet and the extension.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Sign-in providers (each is hidden when its variables are missing) ----
# GitHub OAuth app client id. Callback: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
# GitHub OAuth app client secret.
AUTH_GITHUB_SECRET=
# Google OAuth client id. Callback: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
# Google OAuth client secret.
AUTH_GOOGLE_SECRET=

# ---- Email (Resend) ----
# Resend API key. Needed for the email sign-in link, alerts, invites and the Monday digest.
RESEND_API_KEY=
# From address for all email. Default: BuildMonday <onboarding@resend.dev>
EMAIL_FROM=

# ---- Automation ----
# Bearer secret that Vercel cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=
# 32 bytes, base64, for AES-256-GCM encryption of stored integration secrets. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# When the Monday digest goes out. "weekly" (default): everyone at the Monday 03:30 UTC cron (works on Vercel Hobby).
# "local": 9:00 Monday in each workspace's time zone; call /api/cron/digest every hour on Sundays and Mondays
# (Vercel Pro cron "30 * * * 0,1", or an Upstash QStash schedule) before switching.
DIGEST_SCHEDULE=

# ---- One-click integrations (optional; the paste flows work without them) ----
# Slack app with the incoming-webhook scope. Redirect URL: <APP_URL>/api/integrations/slack/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Linear OAuth application. Callback URL: <APP_URL>/api/integrations/linear/oauth/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# GitHub App with Issues read & write. Callback and Setup URL: <APP_URL>/api/integrations/github/oauth/callback,
# with "Request user authorization (OAuth) during installation" turned on.
GITHUB_APP_ID=
# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key (PEM). Literal 
 line breaks are accepted.
GITHUB_APP_PRIVATE_KEY=

# ---- Chrome extension "Connect this browser" (optional) ----
# Base64 public key written into the downloaded manifest as "key"; it fixes the extension id.
EXTENSION_PUBLIC_KEY=
# The extension id that key produces (shown on chrome://extensions after loading the download).
NEXT_PUBLIC_EXTENSION_ID=

# ---- Billing (Razorpay Subscriptions) ----
# Razorpay key id (returned to the checkout).
RAZORPAY_KEY_ID=
# Razorpay key secret (API Basic auth and checkout signature).
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (X-Razorpay-Signature). Webhook URL: <APP_URL>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan id for Pro, monthly, INR (1,499).
RAZORPAY_PLAN_PRO_MONTHLY_INR=
# Razorpay plan id for Pro, yearly, INR (14,990).
RAZORPAY_PLAN_PRO_YEARLY_INR=
# Razorpay plan id for Team, monthly, INR (4,999).
RAZORPAY_PLAN_TEAM_MONTHLY_INR=
# Razorpay plan id for Team, yearly, INR (49,990).
RAZORPAY_PLAN_TEAM_YEARLY_INR=
# Razorpay plan id for Pro, monthly, USD (19).
RAZORPAY_PLAN_PRO_MONTHLY_USD=
# Razorpay plan id for Pro, yearly, USD (190).
RAZORPAY_PLAN_PRO_YEARLY_USD=
# Razorpay plan id for Team, monthly, USD (59).
RAZORPAY_PLAN_TEAM_MONTHLY_USD=
# Razorpay plan id for Team, yearly, USD (590).
RAZORPAY_PLAN_TEAM_YEARLY_USD=
